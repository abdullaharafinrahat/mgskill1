{
 "duration": 171.1543125,
 "chunks": [
  {
   "i": 0,
   "scene": "hook",
   "speaker": null,
   "text": "একটা ফোনের স্ক্রিন বদলাতে পঞ্চাশ মিনিট।",
   "start": 0.0,
   "end": 3.145,
   "s0": 0.06,
   "s1": 2.82,
   "snapped": true
  },
  {
   "i": 1,
   "scene": "hook",
   "speaker": null,
   "text": "এই একটা লাইনই একসময় জাহিদের দোকানের ভাগ্য বদলে দিয়েছিল।",
   "start": 3.145,
   "end": 7.375,
   "s0": 3.47,
   "s1": 7.16,
   "snapped": true
  },
  {
   "i": 2,
   "scene": "hook",
   "speaker": null,
   "text": "অথচ এক বছর আগে এই দোকানের ভাড়া দিতে না পেরে সে শাটার বন্ধ করে দেওয়ার কথা ভাবছিল।",
   "start": 7.375,
   "end": 13.42,
   "s0": 7.59,
   "s1": 13.17,
   "snapped": true
  },
  {
   "i": 3,
   "scene": "shop",
   "speaker": null,
   "text": "মিরপুরের ছোট একটা মোবাইল সার্ভিসিং দোকান।",
   "start": 13.42,
   "end": 16.165,
   "s0": 13.67,
   "s1": 15.95,
   "snapped": true
  },
  {
   "i": 4,
   "scene": "shop",
   "speaker": null,
   "text": "বাবার রেখে যাওয়া শেষ সম্পদ।",
   "start": 16.165,
   "end": 18.134999999999998,
   "s0": 16.38,
   "s1": 17.9,
   "snapped": true
  },
  {
   "i": 5,
   "scene": "shop",
   "speaker": null,
   "text": "দেয়ালে একটা পুরনো ঘড়ি।",
   "start": 18.134999999999998,
   "end": 19.89,
   "s0": 18.37,
   "s1": 19.7,
   "snapped": true
  },
  {
   "i": 6,
   "scene": "shop",
   "speaker": null,
   "text": "দোকানটা বাঁচাতে জাহিদ কত কিছুই করেছে, শুধু একটা জিনিস কখনো করেনি।",
   "start": 19.89,
   "end": 24.6,
   "s0": 20.08,
   "s1": 24.42,
   "snapped": true
  },
  {
   "i": 7,
   "scene": "shop",
   "speaker": null,
   "text": "নিজের কাজের সময় মেপে দেখেনি।",
   "start": 24.6,
   "end": 26.905,
   "s0": 24.78,
   "s1": 26.72,
   "snapped": true
  },
  {
   "i": 8,
   "scene": "ad",
   "speaker": null,
   "text": "তার বিজ্ঞাপনে লেখা ছিল, “দ্রুত ও নির্ভরযোগ্য মোবাইল সার্ভিস।”",
   "start": 26.905,
   "end": 31.095,
   "s0": 27.09,
   "s1": 30.93,
   "snapped": true
  },
  {
   "i": 9,
   "scene": "ad",
   "speaker": null,
   "text": "কিন্তু দ্রুত মানে কত দ্রুত?",
   "start": 31.095,
   "end": 33.315,
   "s0": 31.26,
   "s1": 33.14,
   "snapped": true
  },
  {
   "i": 10,
   "scene": "cust",
   "speaker": null,
   "text": "প্রতিদিন লোক আসত। ফোন দেখিয়ে জিজ্ঞেস করত,",
   "start": 33.315,
   "end": 36.150000000000006,
   "s0": 33.49,
   "s1": 36.03,
   "snapped": true
  },
  {
   "i": 11,
   "scene": "cust",
   "speaker": "cust",
   "text": "“ভাই, কতক্ষণ লাগবে?”",
   "start": 36.150000000000006,
   "end": 37.629999999999995,
   "s0": 36.27,
   "s1": 37.48,
   "snapped": true
  },
  {
   "i": 12,
   "scene": "cust",
   "speaker": null,
   "text": "জাহিদ বলত,",
   "start": 37.629999999999995,
   "end": 38.565,
   "s0": 37.78,
   "s1": 38.47,
   "snapped": true
  },
  {
   "i": 13,
   "scene": "cust",
   "speaker": "zahid",
   "text": "“হয়ে যাবে।”",
   "start": 38.565,
   "end": 39.269999999999996,
   "s0": 38.66,
   "s1": 39.14,
   "snapped": true
  },
  {
   "i": 14,
   "scene": "cust",
   "speaker": null,
   "text": "লোকটা আবার জিজ্ঞেস করত,",
   "start": 39.269999999999996,
   "end": 40.875,
   "s0": 39.4,
   "s1": 40.74,
   "snapped": true
  },
  {
   "i": 15,
   "scene": "cust",
   "speaker": "cust",
   "text": "“কখন?”",
   "start": 40.875,
   "end": 41.585,
   "s0": 41.01,
   "s1": 41.46,
   "snapped": true
  },
  {
   "i": 16,
   "scene": "cust",
   "speaker": null,
   "text": "জাহিদ কোনো নির্দিষ্ট উত্তর দিতে পারত না।",
   "start": 41.585,
   "end": 43.995000000000005,
   "s0": 41.71,
   "s1": 43.79,
   "snapped": true
  },
  {
   "i": 17,
   "scene": "cust",
   "speaker": null,
   "text": "কিছুক্ষণ পর লোকটা ফোন নিয়ে পাশের বড় দোকানে চলে যেত।",
   "start": 43.995000000000005,
   "end": 47.505,
   "s0": 44.2,
   "s1": 47.34,
   "snapped": true
  },
  {
   "i": 18,
   "scene": "girl",
   "speaker": null,
   "text": "একদিন একটা স্কুলপড়ুয়া মেয়ে এল। পরদিন তার পরীক্ষা।",
   "start": 47.505,
   "end": 51.04,
   "s0": 47.67,
   "s1": 50.85,
   "snapped": true
  },
  {
   "i": 19,
   "scene": "girl",
   "speaker": null,
   "text": "সব পড়া ফোনে। স্ক্রিনটা ভাঙা।",
   "start": 51.04,
   "end": 53.32,
   "s0": 51.23,
   "s1": 53.17,
   "snapped": true
  },
  {
   "i": 20,
   "scene": "girl",
   "speaker": null,
   "text": "মেয়েটা জিজ্ঞেস করল,",
   "start": 53.32,
   "end": 54.495000000000005,
   "s0": 53.47,
   "s1": 54.4,
   "snapped": true
  },
  {
   "i": 21,
   "scene": "girl",
   "speaker": "girl",
   "text": "“ভাইয়া, আজ রাতের মধ্যে পাব?”",
   "start": 54.495000000000005,
   "end": 56.400000000000006,
   "s0": 54.59,
   "s1": 56.28,
   "snapped": true
  },
  {
   "i": 22,
   "scene": "girl",
   "speaker": null,
   "text": "জাহিদ বলল,",
   "start": 56.400000000000006,
   "end": 57.275000000000006,
   "s0": 56.52,
   "s1": 57.17,
   "snapped": true
  },
  {
   "i": 23,
   "scene": "girl",
   "speaker": "zahid",
   "text": "“হয়ে যাবে।”",
   "start": 57.275000000000006,
   "end": 57.995000000000005,
   "s0": 57.38,
   "s1": 57.86,
   "snapped": true
  },
  {
   "i": 24,
   "scene": "girl",
   "speaker": null,
   "text": "মেয়েটা কিছুক্ষণ চুপ করে থেকে বলল,",
   "start": 57.995000000000005,
   "end": 60.084999999999994,
   "s0": 58.13,
   "s1": 59.94,
   "snapped": true
  },
  {
   "i": 25,
   "scene": "girl",
   "speaker": "girl",
   "text": "“হয়ে যাবে মানে কখন?",
   "start": 60.084999999999994,
   "end": 61.595,
   "s0": 60.23,
   "s1": 61.45,
   "snapped": true
  },
  {
   "i": 26,
   "scene": "girl",
   "speaker": "girl",
   "text": "আমি অপেক্ষা করব, নাকি অন্য দোকানে যাব?”",
   "start": 61.595,
   "end": 64.035,
   "s0": 61.74,
   "s1": 63.83,
   "snapped": true
  },
  {
   "i": 27,
   "scene": "realize",
   "speaker": null,
   "text": "কথাটা খুব সাধারণ।",
   "start": 64.035,
   "end": 65.52,
   "s0": 64.24,
   "s1": 65.38,
   "snapped": true
  },
  {
   "i": 28,
   "scene": "realize",
   "speaker": null,
   "text": "কিন্তু জাহিদের কাছে সেদিন প্রথমবার মনে হলো,",
   "start": 65.52,
   "end": 68.28,
   "s0": 65.66,
   "s1": 68.16,
   "snapped": true
  },
  {
   "i": 29,
   "scene": "realize",
   "speaker": null,
   "text": "মানুষ শুধু ফোন ঠিক করাতে আসে না।",
   "start": 68.28,
   "end": 70.42500000000001,
   "s0": 68.4,
   "s1": 70.29,
   "snapped": true
  },
  {
   "i": 30,
   "scene": "realize",
   "speaker": null,
   "text": "তারা জানতে চায়, ফোনটা কখন ফিরে পাবে।",
   "start": 70.42500000000001,
   "end": 73.16,
   "s0": 70.56,
   "s1": 73.02,
   "snapped": true
  },
  {
   "i": 31,
   "scene": "night",
   "speaker": null,
   "text": "সেদিন রাতে দোকান বন্ধ করার পর জাহিদ প্রথমবার দেয়ালের ঘড়িটার দিকে তাকাল।",
   "start": 73.16,
   "end": 77.9,
   "s0": 73.3,
   "s1": 77.76,
   "snapped": true
  },
  {
   "i": 32,
   "scene": "night",
   "speaker": null,
   "text": "তারপর দশটা ফোনের স্ক্রিন বদল করল। প্রতিটার শুরুর সময় আর শেষের সময় খাতায় লিখল।",
   "start": 77.9,
   "end": 83.35,
   "s0": 78.04,
   "s1": 83.23,
   "snapped": true
  },
  {
   "i": 33,
   "scene": "night",
   "speaker": null,
   "text": "দেখল, সাধারণ মডেলের স্ক্রিন বদলাতে সবচেয়ে বেশি সময় লেগেছে পঞ্চাশ মিনিট।",
   "start": 83.35,
   "end": 88.305,
   "s0": 83.47,
   "s1": 88.19,
   "snapped": true
  },
  {
   "i": 34,
   "scene": "night",
   "speaker": null,
   "text": "সবচেয়ে কম চল্লিশ।",
   "start": 88.305,
   "end": 89.97999999999999,
   "s0": 88.42,
   "s1": 89.83,
   "snapped": true
  },
  {
   "i": 35,
   "scene": "newad",
   "speaker": null,
   "text": "পরদিন সকালে বিজ্ঞাপনের পুরনো লাইনটা কেটে দিল।",
   "start": 89.97999999999999,
   "end": 93.015,
   "s0": 90.13,
   "s1": 92.9,
   "snapped": true
  },
  {
   "i": 36,
   "scene": "newad",
   "speaker": null,
   "text": "নতুন করে লিখল:",
   "start": 93.015,
   "end": 94.16,
   "s0": 93.13,
   "s1": 94.04,
   "snapped": true
  },
  {
   "i": 37,
   "scene": "newad",
   "speaker": null,
   "text": "“সাধারণ মডেলের স্ক্রিন বদলান ৫০ মিনিটে।",
   "start": 94.16,
   "end": 96.92,
   "s0": 94.28,
   "s1": 96.81,
   "snapped": true
  },
  {
   "i": 38,
   "scene": "newad",
   "speaker": null,
   "text": "না পারলে চার্জ অর্ধেক।”",
   "start": 96.92,
   "end": 98.72,
   "s0": 97.03,
   "s1": 98.53,
   "snapped": true
  },
  {
   "i": 39,
   "scene": "day1",
   "speaker": null,
   "text": "প্রথম দিন ছয়জন কাস্টমার এল।",
   "start": 98.72,
   "end": 100.745,
   "s0": 98.91,
   "s1": 100.62,
   "snapped": true
  },
  {
   "i": 40,
   "scene": "day1",
   "speaker": null,
   "text": "এবার কেউ শুধু দাম জিজ্ঞেস করল না।",
   "start": 100.745,
   "end": 102.935,
   "s0": 100.87,
   "s1": 102.83,
   "snapped": true
  },
  {
   "i": 41,
   "scene": "day1",
   "speaker": null,
   "text": "তারা ঘড়ির দিকে তাকিয়ে অপেক্ষা করল।",
   "start": 102.935,
   "end": 105.255,
   "s0": 103.04,
   "s1": 105.1,
   "snapped": true
  },
  {
   "i": 42,
   "scene": "rare",
   "speaker": null,
   "text": "কিন্তু আসল পরীক্ষাটা এল তৃতীয় সপ্তাহে।",
   "start": 105.255,
   "end": 107.89500000000001,
   "s0": 105.41,
   "s1": 107.75,
   "snapped": true
  },
  {
   "i": 43,
   "scene": "rare",
   "speaker": null,
   "text": "একজন কাস্টমার নিয়ে এলেন একটা বিরল মডেলের ফোন।",
   "start": 107.89500000000001,
   "end": 110.89500000000001,
   "s0": 108.04,
   "s1": 110.79,
   "snapped": true
  },
  {
   "i": 44,
   "scene": "rare",
   "speaker": null,
   "text": "কাজ করতে সত্তর মিনিট লাগল।",
   "start": 110.89500000000001,
   "end": 112.9,
   "s0": 111.0,
   "s1": 112.79,
   "snapped": true
  },
  {
   "i": 45,
   "scene": "rare",
   "speaker": null,
   "text": "জাহিদ ফোনটা হাতে দিয়ে বলল,",
   "start": 112.9,
   "end": 114.61,
   "s0": 113.01,
   "s1": 114.5,
   "snapped": true
  },
  {
   "i": 46,
   "scene": "rare",
   "speaker": "zahid",
   "text": "“ভাই, আমার কথা রাখতে পারিনি।",
   "start": 114.61,
   "end": 116.41,
   "s0": 114.72,
   "s1": 116.3,
   "snapped": true
  },
  {
   "i": 47,
   "scene": "rare",
   "speaker": "zahid",
   "text": "তাই শ্রমের চার্জ অর্ধেক দিন।”",
   "start": 116.41,
   "end": 118.235,
   "s0": 116.52,
   "s1": 118.11,
   "snapped": true
  },
  {
   "i": 48,
   "scene": "rare",
   "speaker": null,
   "text": "লোকটা অবাক হয়ে বললেন,",
   "start": 118.235,
   "end": 119.675,
   "s0": 118.36,
   "s1": 119.57,
   "snapped": true
  },
  {
   "i": 49,
   "scene": "rare",
   "speaker": "cust",
   "text": "“আপনি নিজে থেকেই কমাচ্ছেন?”",
   "start": 119.675,
   "end": 121.395,
   "s0": 119.78,
   "s1": 121.21,
   "snapped": true
  },
  {
   "i": 50,
   "scene": "rare",
   "speaker": null,
   "text": "জাহিদ শুধু মাথা নাড়ল।",
   "start": 121.395,
   "end": 123.19,
   "s0": 121.58,
   "s1": 122.97,
   "snapped": true
  },
  {
   "i": 51,
   "scene": "rare",
   "speaker": null,
   "text": "পরের সপ্তাহে সেই লোক নিজের ভাইকে নিয়ে এলেন।",
   "start": 123.19,
   "end": 126.19,
   "s0": 123.41,
   "s1": 126.02,
   "snapped": true
  },
  {
   "i": 52,
   "scene": "resp",
   "speaker": null,
   "text": "ধীরে ধীরে জাহিদ বুঝল,",
   "start": 126.19,
   "end": 128.06,
   "s0": 126.36,
   "s1": 127.87,
   "snapped": true
  },
  {
   "i": 53,
   "scene": "resp",
   "speaker": null,
   "text": "শুধু দ্রুত কাজ করলেই হয় না।",
