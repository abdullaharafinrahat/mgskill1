   "snapped": true
  },
  {
   "i": 60,
   "scene": "take",
   "speaker": null,
   "text": "আমার কথাটা কি কেউ ঘড়ি ধরে মিলিয়ে দেখতে পারবে?",
   "start": 152.62,
   "end": 155.615,
   "s0": 152.78,
   "s1": 155.41,
   "snapped": true
  },
  {
   "i": 61,
   "scene": "end",
   "speaker": null,
   "text": "জাহিদের দোকানের ঘড়িটা এখনও দেয়ালে।",
   "start": 155.615,
   "end": 158.39,
   "s0": 155.82,
   "s1": 158.18,
   "snapped": true
  },
  {
   "i": 62,
   "scene": "end",
   "speaker": null,
   "text": "পার্থক্য শুধু একটাই, এখন সে আর ঘড়িটাকে এড়িয়ে চলে না।",
   "start": 158.39,
