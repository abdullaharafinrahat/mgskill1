   "snapped": true
  },
  {
   "i": 59,
   "scene": "take",
   "speaker": null,
   "text": "পরের বার বিজ্ঞাপন লেখার আগে নিজেকে জিজ্ঞেস করো,",
   "start": 149.435,
   "end": 152.62,
   "s0": 149.64,
