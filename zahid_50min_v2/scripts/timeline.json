{
 "duration": 124.37,
 "scenes": [
  {
   "name": "hook",
   "start": 0.0,
   "end": 7.82,
   "chunks": [
    {
     "text": "একটা ফোনের স্ক্রিন বদলাতে পঞ্চাশ মিনিট।",
     "start": 0.0,
     "end": 3.77,
     "syl": 18.0
    },
    {
     "text": "এই একটা লাইনই একসময় জাহিদের দোকানের ভাগ্য বদলে দিয়েছিল।",
     "start": 3.77,
     "end": 7.82,
     "syl": 31.0
    }
   ]
  },
  {
   "name": "rent",
   "start": 7.82,
   "end": 14.01,
   "chunks": [
    {
     "text": "অথচ এক বছর আগে এই দোকানের ভাড়া দিতে না পেরে সে শাটার বন্ধ করে দেওয়ার কথা ভাবছিল।",
     "start": 7.82,
     "end": 14.01,
     "syl": 41.0
    }
   ]
  },
  {
   "name": "street",
   "start": 14.01,
   "end": 16.69,
   "chunks": [
    {
     "text": "মিরপুরের ছোট একটা মোবাইল সার্ভিসিং দোকান।",
     "start": 14.01,
     "end": 16.69,
     "syl": 20.0
    }
   ]
  },
  {
   "name": "inside",
   "start": 16.69,
   "end": 20.92,
   "chunks": [
    {
     "text": "বাবার রেখে যাওয়া শেষ সম্পদ।",
     "start": 16.69,
     "end": 18.91,
     "syl": 13.0
    },
    {
     "text": "দেয়ালে একটা পুরনো ঘড়ি।",
     "start": 18.91,
     "end": 20.92,
     "syl": 11.0
    }
   ]
  },
  {
   "name": "busy",
   "start": 20.92,
   "end": 28.06,
   "chunks": [
    {
     "text": "দোকানটা বাঁচাতে জাহিদ কত কিছুই করেছে, শুধু একটা জিনিস কখনো করেনি।",
     "start": 20.92,
     "end": 25.76,
     "syl": 32.0
    },
    {
     "text": "নিজের কাজের সময় মেপে দেখেনি।",
     "start": 25.76,
     "end": 28.06,
     "syl": 14.0
    }
   ]
  },
  {
   "name": "ad",
   "start": 28.06,
   "end": 34.86,
   "chunks": [
    {
     "text": "তার বিজ্ঞাপনে লেখা ছিল, “দ্রুত ও নির্ভরযোগ্য মোবাইল সার্ভিস।”",
     "start": 28.06,
     "end": 32.26,
     "syl": 25.0
    },
    {
     "text": "কিন্তু দ্রুত মানে কত দ্রুত?",
     "start": 32.26,
     "end": 34.86,
     "syl": 10.0
    }
   ]
  },
  {
   "name": "counter",
   "start": 34.86,
   "end": 51.34,
   "chunks": [
    {
     "text": "প্রতিদিন লোক আসত।",
     "start": 34.86,
     "end": 36.31,
     "syl": 9.0
    },
    {
     "text": "ফোন দেখিয়ে জিজ্ঞেস করত, “ভাই, কতক্ষণ লাগবে?”",
     "start": 36.31,
     "end": 39.66,
     "syl": 20.0
    },
    {
     "text": "জাহিদ বলত, “হয়ে যাবে।”",
     "start": 39.66,
     "end": 41.88,
     "syl": 10.0
    },
    {
     "text": "লোকটা আবার জিজ্ঞেস করত, “কখন?”",
     "start": 41.88,
     "end": 44.49,
     "syl": 15.0
    },
    {
     "text": "জাহিদ কোনো নির্দিষ্ট উত্তর দিতে পারত না।",
     "start": 44.49,
     "end": 47.02,
     "syl": 17.0
    },
    {
     "text": "কিছুক্ষণ পর লোকটা ফোন নিয়ে পাশের বড় দোকানে চলে যেত।",
     "start": 47.02,
     "end": 51.34,
     "syl": 25.0
    }
   ]
  },
  {
   "name": "girl1",
   "start": 51.34,
   "end": 57.49,
   "chunks": [
    {
     "text": "একদিন একটা স্কুলপড়ুয়া মেয়ে এল।",
     "start": 51.34,
     "end": 53.4,
     "syl": 16.0
    },
    {
     "text": "পরদিন তার পরীক্ষা।",
     "start": 53.4,
     "end": 54.78,
     "syl": 9.0
    },
    {
     "text": "সব পড়া ফোনে।",
     "start": 54.78,
     "end": 56.04,
     "syl": 6.0
    },
    {
     "text": "স্ক্রিনটা ভাঙা।",
     "start": 56.04,
     "end": 57.49,
     "syl": 5.0
    }
   ]
  },
  {
   "name": "girl2",
   "start": 57.49,
   "end": 71.41,
   "chunks": [
    {
     "text": "মেয়েটা জিজ্ঞেস করল, “ভাইয়া, আজ রাতের মধ্যে পাব?”",
     "start": 57.49,
     "end": 61.41,
     "syl": 21.0
    },
    {
     "text": "জাহিদ বলল, “হয়ে যাবে।”",
     "start": 61.41,
     "end": 64.07,
     "syl": 10.0
    },
    {
     "text": "মেয়েটা কিছুক্ষণ চুপ করে থেকে বলল, “হয়ে যাবে মানে কখন? আমি অপেক্ষা করব, নাকি অন্য দোকানে যাব?”",
     "start": 64.07,
     "end": 71.41,
     "syl": 42.0
    }
   ]
  },
  {
   "name": "realize",
   "start": 71.41,
   "end": 81.18,
   "chunks": [
    {
     "text": "কথাটা খুব সাধারণ।",
     "start": 71.41,
     "end": 72.92,
     "syl": 9.0
    },
    {
     "text": "কিন্তু জাহিদের কাছে সেদিন প্রথমবার মনে হলো, মানুষ শুধু ফোন ঠিক করাতে আসে না।",
     "start": 72.92,
     "end": 77.9,
     "syl": 35.0
    },
    {
     "text": "তারা জানতে চায়, ফোনটা কখন ফিরে পাবে।",
     "start": 77.9,
     "end": 81.18,
     "syl": 17.0
    }
   ]
  },
  {
   "name": "night",
   "start": 81.18,
   "end": 100.34,
   "chunks": [
    {
     "text": "সেদিন রাতে দোকান বন্ধ করার পর জাহিদ প্রথমবার দেয়ালের ঘড়িটার দিকে তাকাল।",
     "start": 81.18,
     "end": 86.22,
     "syl": 36.0
    },
    {
     "text": "তারপর দশটা ফোনের স্ক্রিন বদল করল।",
     "start": 86.22,
     "end": 88.96,
     "syl": 18.0
    },
    {
     "text": "প্রতিটার শুরুর সময় আর শেষের সময় খাতায় লিখল।",
     "start": 88.96,
     "end": 92.49,
     "syl": 24.0
    },
    {
     "text": "দেখল, সাধারণ মডেলের স্ক্রিন বদলাতে সবচেয়ে বেশি সময় লেগেছে পঞ্চাশ মিনিট।",
     "start": 92.49,
     "end": 97.92,
     "syl": 35.0
    },
    {
     "text": "সবচেয়ে কম চল্লিশ।",
     "start": 97.92,
     "end": 100.34,
     "syl": 9.0
    }
   ]
  },
  {
   "name": "sign",
   "start": 100.34,
   "end": 109.91,
   "chunks": [
    {
     "text": "পরদিন সকালে বিজ্ঞাপনের পুরনো লাইনটা কেটে দিল।",
     "start": 100.34,
     "end": 103.25,
     "syl": 23.0
    },
    {
     "text": "নতুন করে লিখল:",
     "start": 103.25,
     "end": 104.6,
     "syl": 8.0
    },
    {
     "text": "“সাধারণ মডেলের স্ক্রিন বদলান ৫০ মিনিটে। না পারলে চার্জ অর্ধেক।”",
     "start": 104.6,
     "end": 109.91,
     "syl": 29.0
    }
   ]
  },
  {
   "name": "six",
   "start": 109.91,
   "end": 117.2,
   "chunks": [
    {
     "text": "প্রথম দিন ছয়জন কাস্টমার এল।",
     "start": 109.91,
     "end": 111.94,
     "syl": 15.0
    },
    {
     "text": "এবার কেউ শুধু দাম জিজ্ঞেস করল না।",
     "start": 111.94,
     "end": 114.24,
     "syl": 16.0
    },
    {
     "text": "তারা ঘড়ির দিকে তাকিয়ে অপেক্ষা করল।",
     "start": 114.24,
     "end": 117.2,
     "syl": 16.0
    }
   ]
  },
  {
   "name": "rare",
   "start": 117.2,
   "end": 124.37,
   "chunks": [
    {
     "text": "কিন্তু আসল পরীক্ষাটা এল তৃতীয় সপ্তাহে।",
     "start": 117.2,
     "end": 119.94,
     "syl": 17.0
    },
    {
     "text": "একজন কাস্টমার নিয়ে এলেন একটা বিরল মডেলের ফোন।",
     "start": 119.94,
     "end": 123.34,
     "syl": 25.0
    },
    {
     "text": "কাজ করতে সত্তর মিনিট লাগল।",
     "start": 123.34,
     "end": 124.37,
     "syl": 14.0
    }
   ]
  }
 ],
